{
    "name": "dimita/laravel-business-orchestration-engine",
    "description": "A Laravel library for business orchestration including Saga Pattern, Workflow, Event Sourcing, Versioning, Rule Engine, and more.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Dimita",
            "email": "your-email@example.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "laravel/framework": "^10.0|^11.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "orchestra/testbench": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "Dimita\\BusinessOrchestration\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dimita\\BusinessOrchestration\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Dimita\\BusinessOrchestration\\BusinessOrchestrationServiceProvider"
            ]
        }
    }
}